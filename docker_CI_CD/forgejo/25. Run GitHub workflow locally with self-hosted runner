# get_config_with_restconf.py
import json
import yaml
import requests
import os
from nornir import InitNornir
from rich import print as rprint

requests.packages.urllib3.disable_warnings()

# Initialize Nornir with the configuration file
nr = InitNornir(config_file="config.yaml")

# Load environment variables for username and password
username = os.getenv('TEST_USERNAME')
password = os.getenv('TEST_PASSWORD')

if not username or not password:
    raise ValueError("Username or password environment variable not set.")

headers = {"Accept": "application/yang-data+json"}

def restconf_get_config(task):
    # Ensure the username and password are set from environment variables
    task.host.username = username
    task.host.password = password

    url = f"https://{task.host.hostname}:443/restconf/data/Cisco-IOS-XE-native:native"
    response = requests.get(url=url, headers=headers, auth=(task.host.username, task.host.password), verify=False)

    if response.status_code == 200:
        task.host["data"] = response.json()
        result = task.host["data"]

        # Convert JSON to YAML
        yaml_data = yaml.dump(result, default_flow_style=False, sort_keys=False)

        # Save YAML to a file named after the device
        filename = f"host_vars/{task.host.name}.yaml"
        with open(filename, "w") as yaml_file:
            yaml_file.write(yaml_data)

        rprint(f"Configuration saved to {filename}")
    else:
        rprint(f"Failed to retrieve config from {task.host.hostname}. Status code: {response.status_code}")

# Run the task across all hosts in the inventory
nr.run(task=restconf_get_config)
