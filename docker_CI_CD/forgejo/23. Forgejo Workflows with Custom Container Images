# Base image
FROM python:3.11-slim

# Install system dependencies + Node.js
RUN apt-get update && \
    apt-get install -y \
      git \
      curl \
      ssh \
      ca-certificates \
      nodejs \
      npm \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip

# Install Python dependencies
RUN python -m pip install \
    nornir \
    nornir-utils \
    nornir-jinja2 \
    jinja2 \
    netmiko \
    nornir-scrapli

# Set working directory
WORKDIR /workspace

# Default command
CMD ["bash"]


